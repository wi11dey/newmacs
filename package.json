{
    "name": "newmacs",
    "version": "1.0.0",
    "description": "Beautiful, modern Emacs frontend.",
    "scripts": {
        "dev": "tauri dev",
        "dev:renderer": "shadow-cljs watch renderer",
        "build": "tauri build --bundles app",
        "build:renderer": "shadow-cljs release renderer",
        "clean": "rm -rf resources/public/js/* target src-tauri/target",
	"format": "cargo fmt --manifest-path src-tauri/Cargo.toml"
    },
    "keywords": [
        "shadow-cljs",
        "reagent",
        "tauri"
    ],
    "author": "Will Dey <will_dey@alumni.harvard.edu>",
    "license": "MIT",
    "dependencies": {
        "@replit/codemirror-minimap": "^0.5.2",
        "@uiw/react-codemirror": "^4.25.11",
        "flexlayout-react": "^0.10.1",
        "@tauri-apps/api": "^2.8.0",
        "react": "^18.1.0",
        "react-dom": "^18.1.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.8.4",
        "shadow-cljs": "^3.4.11"
    }
}
